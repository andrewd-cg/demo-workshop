FROM cgr.dev/andrewd.dev/node:24-dev AS builder

WORKDIR /app

COPY package.json ./

# Copying the .npmrc file into an image is not recommended as it may contain sensitive information. 
#RUN npm install --omit=dev
# Instead, we can use Docker's build secrets to securely pass the .npmrc file during the build process. 
# Here's how you can modify the Dockerfile to use build secrets:
RUN --mount=type=secret,id=npmrc,target=/app/.npmrc npm install --omit=dev

COPY index.js ./

# No Package Manager, No Shell or other utilities for maximum runtime security
FROM cgr.dev/andrewd.dev/node:24-slim

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/index.js ./index.js
COPY --from=builder /app/package*.json ./

EXPOSE 3000

ENTRYPOINT ["node", "index.js"]
